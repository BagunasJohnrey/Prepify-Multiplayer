# ── Server configuration ──
# Copy this file to `.env` in the project ROOT and fill in real values.

NODE_ENV=development
PORT=3000

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — use a long, random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string

# AI providers (used for quiz generation). Gemini + Groq fall back to each other.
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Optional model overrides (comma-separated candidate list tried in order)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_MODELS=llama-4-scout-17b-16e-instruct,llama-3.3-70b-versatile,gemma-2-9b-it

# CORS: the origin your frontend is served from
CLIENT_URL=http://localhost:5173

# TLS cert validation for the DB. Keep true (Neon cert is publicly trusted).
# Only set to "false" for local dev with a self-signed DB cert.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: used by `npm run seed` to create/promote an admin account
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
