# ── Server configuration ──
# Copy this file to `.env` in the project ROOT and fill in real values.

NODE_ENV=development
PORT=3000

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — use a long, random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string

# AI providers (used for quiz generation). Gemini + Groq fall back to each other.
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Optional model overrides (comma-separated candidate list tried in order)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b,groq/compound-mini

# CORS: the origin your frontend is served from
CLIENT_URL=http://localhost:5173

# TLS cert validation for the DB. Keep true (Neon cert is publicly trusted).
# Only set to "false" for local dev with a self-signed DB cert.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: used by `npm run seed` to create/promote an admin account
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me

# Google OAuth (required for Google Sign-In)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
