# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database (Testcontainers will override)
DATABASE_URL=postgresql://prepify:prepify@localhost:5432/prepify_test

# JWT Secret for testing (min 32 chars)
JWT_SECRET=test-secret-key-minimum-32-characters-long

# AI Providers (mocked in tests)
GEMINI_API_KEY=test-gemini-key
GROQ_API_KEY=test-groq-key

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Redis for rate limiting
REDIS_URL=redis://localhost:6379

# Disable SSL cert validation for local test DB
DB_SSL_REJECT_UNAUTHORIZED=false

# Email (disabled in tests)
# SMTP_HOST=