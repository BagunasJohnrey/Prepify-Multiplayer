{
  "name": "prepify",
  "version": "1.0.0",
  "description": "AI-Powered Exam Preparation Platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server/scripts/migrate.js && node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm install && cd client && npm install --include=dev && npm run build",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seedAdmin.js",
    "test": "node --test server/test/auth.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pdf2json": "^4.0.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.11",
    "supertest": "^7.0.0"
  }
}
